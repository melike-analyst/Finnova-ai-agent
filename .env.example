# Bu dosyayı .env olarak kopyalayıp kendi anahtarlarınızı girin.
# .env dosyasını ASLA GitHub'a push etmeyin (bkz. .gitignore).

# Anthropic API anahtarınız: https://console.anthropic.com/settings/keys
GEMINI_API_KEY=sk-ant-...

# Otomasyon raporlarının gönderileceği Slack Incoming Webhook URL'i (opsiyonel)
# Kurulum: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# İleride e-posta entegrasyonu eklemek isterseniz (opsiyonel)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
