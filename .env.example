# Bu dosyayı .env olarak kopyalayıp kendi anahtarlarınızı girin.
# .env dosyasını ASLA GitHub'a push etmeyin .

# Google Gemini API anahtarınız (ücretsiz, kredi kartı gerekmez):
# https://aistudio.google.com/apikey adresinden "Create API key" ile alın
GEMINI_API_KEY=AQ...

# Otomasyon raporlarının gönderileceği Slack Incoming Webhook URL'i (opsiyonel)
# Kurulum: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# İleride e-posta entegrasyonu eklemek isterseniz (opsiyonel)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
